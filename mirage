#!/usr/bin/env bash
# mirage — local Kafka Connect incident-response trainer (KCD / Strimzi).
#
#   mirage setup          create the cluster + Strimzi + Kafka + Connect + ingress
#   mirage list           show all labs and your results
#   mirage start <n>      inject lab n's fault(s)
#   mirage stop <n>       grade your fix
#   mirage hint <n>       nudge
#   mirage solve <n>      full answer
#   mirage status         current cluster + lab state
#   mirage counts         source vs target record counts
#   mirage topics         topics on both clusters
#   mirage logs           tail a Connect worker
#   mirage metrics [pat]  scrape the JMX exporter
#   mirage answer <n> <v> record a triage conclusion (labs that ask for one)
#   mirage reset          restore the baseline without re-creating the cluster
#   mirage teardown       delete the cluster

set -uo pipefail

# Resolve symlinks before deriving LAB_HOME. If this script is reached through a
# symlink (e.g. /usr/local/bin/mirage -> .../mirage/mirage), dirname gives
# the SYMLINK's directory, and lib/, labs/ and manifests/ are not there.
# readlink -f is GNU-only, so walk the links by hand for macOS.
_kcd_self="${BASH_SOURCE[0]}"
while [ -L "$_kcd_self" ]; do
  _kcd_link="$(readlink "$_kcd_self")"
  case "$_kcd_link" in
    /*) _kcd_self="$_kcd_link" ;;                                   # absolute
    *)  _kcd_self="$(dirname "$_kcd_self")/$_kcd_link" ;;           # relative
  esac
done
LAB_HOME="$(cd "$(dirname "$_kcd_self")" && pwd)"
unset _kcd_self _kcd_link
# kind/minikube may be installed in ~/.local/bin rather than a brew prefix.
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac
export PATH
# shellcheck source=lib/common.sh
source "$LAB_HOME/lib/common.sh"

# The cluster name lives in lib/provider.sh as LAB_CLUSTER, so both the
# provider verbs and the commands here agree on it.
STRIMZI_VERSION=0.47.0
INGRESS_NGINX_VERSION=1.11.3

# ---------------------------------------------------------------- lab registry

lab_file() {
  local n="$1"
  local f
  f="$(find "$LAB_HOME/labs" -name "$(printf '%02d' "$n")-*.sh" -maxdepth 1 2>/dev/null | head -1)"
  [ -n "$f" ] && printf '%s' "$f"
}

load_lab() {
  local n="$1" f
  f="$(lab_file "$n")"
  if [ -z "$f" ]; then err "No such lab: $n (try: mirage list)"; exit 1; fi
  unset -f lab_brief lab_break lab_check lab_hint lab_solve 2>/dev/null
  LAB_TITLE=""; LAB_DIFFICULTY=""; LAB_ALERT=""
  # shellcheck disable=SC1090
  source "$f"
}

all_lab_numbers() {
  find "$LAB_HOME/labs" -maxdepth 1 -name '[0-9][0-9]-*.sh' 2>/dev/null \
    | sed 's#.*/##; s/^0*//; s/-.*//' | sort -n
}

# ---------------------------------------------------------------------- setup

cmd_setup() {
  hr
  say "${C_B}Mirage environment setup${C_0}"
  hr

  local provider
  if ! provider="$(provider_detect)"; then
    err "No cluster provider found. Install one:"
    say "    brew install kind         # or"
    say "    brew install minikube"
    say ""
    say "  Pick explicitly with: MIRAGE_PROVIDER=minikube ./mirage setup"
    exit 1
  fi
  case "$provider" in
    kind|minikube) ;;
    *) err "Unknown MIRAGE_PROVIDER '$provider' (expected: kind | minikube)"; exit 1 ;;
  esac
  say "  ${C_GRN}ok${C_0}      provider: ${C_B}$provider${C_0} ${C_DIM}(override with MIRAGE_PROVIDER)${C_0}"

  local missing=()
  for bin in docker "$(provider_binary "$provider")" kubectl; do
    if command -v "$bin" >/dev/null 2>&1; then
      say "  ${C_GRN}found${C_0}   $bin"
    else
      say "  ${C_RED}missing${C_0} $bin"
      missing+=("$bin")
    fi
  done

  if [ "${#missing[@]}" -gt 0 ]; then
    say ""
    err "Install the missing tool(s) first:"
    local brews=() casks=()
    for m in "${missing[@]}"; do
      case "$m" in
        docker) casks+=("docker") ;;
        *)      brews+=("$m") ;;
      esac
    done
    [ "${#brews[@]}" -gt 0 ] && say "    brew install ${brews[*]}"
    [ "${#casks[@]}" -gt 0 ] && say "    brew install --cask ${casks[*]}     # or Rancher Desktop"
    exit 1
  fi

  if ! docker info >/dev/null 2>&1; then
    say ""
    err "Docker is not reachable."
    say "  If you use Docker Desktop:   open -a Docker"
    say "  If you use Rancher Desktop:  start the app"
    say "  If you use colima:           colima start --cpu 8 --memory 16"
    say ""
    say "  Already running? Your docker context may point at a socket that does"
    say "  not exist — common with colima, whose socket is not /var/run/docker.sock."
    say ""
    say "    docker context ls            # find the one whose endpoint exists"
    say "    docker context use colima    # then select it"
    say ""
    say "  ${C_DIM}minikube and kind both read the active context, so this must be"
    say "  right before either can create a cluster.${C_0}"
    exit 1
  fi
  say "  ${C_GRN}ok${C_0}      docker daemon responding"

  # The labs need ~6GB of VM memory for two Kafka clusters plus Connect.
  local dmem
  dmem="$(docker info --format '{{.MemTotal}}' 2>/dev/null)"
  if [ -n "$dmem" ] && [ "$dmem" -gt 0 ] 2>/dev/null; then
    local dmem_gb=$(( dmem / 1024 / 1024 / 1024 ))
    if [ "$dmem_gb" -lt 5 ]; then
      warn "Docker has only ~${dmem_gb}GB of memory; the labs want 6GB+."
      warn "Kafka or Connect may be OOMKilled. Raise it in your Docker/colima settings."
    else
      say "  ${C_GRN}ok${C_0}      docker memory ~${dmem_gb}GB"
    fi
  fi
  say ""

  if provider_cluster_exists "$provider"; then
    info "$provider cluster '$LAB_CLUSTER' already exists — reusing it"
    provider_export_kubeconfig "$provider"
  else
    info "Creating $provider cluster '$LAB_CLUSTER' (a few minutes)"
    provider_create "$provider" || {
      err "$provider cluster creation failed"; exit 1; }
    provider_export_kubeconfig "$provider"
  fi
  # Record which provider owns this cluster, so a later teardown/repair in a
  # different shell acts on the right one even if detection would now differ.
  provider_save "$provider"

  info "Creating namespace '$NS'"
  kubectl create namespace "$NS" >/dev/null 2>&1 || true

  # Pin the namespace into the kubeconfig itself, so raw kubectl against this
  # cluster does not need -n mirage on every command. A child process cannot
  # change the parent shell's environment, but it CAN write this file — and the
  # setting then applies to anyone who exports KUBECONFIG.
  kubectl config set-context --current --namespace="$NS" >/dev/null 2>&1 || true

  info "Installing Strimzi operator $STRIMZI_VERSION (vendored, no network needed)"
  if [ -d "$LAB_HOME/vendor/strimzi-$STRIMZI_VERSION" ]; then
    kubectl apply -f "$LAB_HOME/vendor/strimzi-$STRIMZI_VERSION/" -n "$NS" >/dev/null || {
      err "Strimzi install failed"; exit 1; }
  else
    warn "vendored manifests missing; falling back to strimzi.io"
    kubectl apply -f "https://strimzi.io/install/$STRIMZI_VERSION?namespace=$NS" -n "$NS" >/dev/null || {
      err "Strimzi install failed — check network access to strimzi.io"; exit 1; }
  fi

  spin_until 300 "waiting for the Strimzi operator" \
    bash -c "kubectl -n $NS get deploy strimzi-cluster-operator -o jsonpath='{.status.readyReplicas}' 2>/dev/null | grep -q '^[1-9]'"

  info "Installing ingress-nginx $INGRESS_NGINX_VERSION (vendored)"
  # No -n here: this manifest carries its own `ingress-nginx` namespace, and
  # kubectl rejects -n when it disagrees with an explicit namespace in the file.
  # Applied before Kafka so the controller pulls and starts while the brokers
  # are coming up.
  if [ -f "$LAB_HOME/vendor/ingress-nginx-$INGRESS_NGINX_VERSION/deploy.yaml" ]; then
    kubectl apply -f "$LAB_HOME/vendor/ingress-nginx-$INGRESS_NGINX_VERSION/deploy.yaml" >/dev/null || {
      warn "ingress-nginx install failed; the REST API will be unreachable from the host"; }
  else
    warn "vendored ingress-nginx manifest missing; the REST API will not be exposed"
  fi

  info "Deploying source and target Kafka clusters (Kafka 4.0.0, KRaft)"
  kubectl apply -f "$LAB_HOME/manifests/kafka.yaml" >/dev/null

  info "Waiting for Kafka clusters (up to 10 minutes on first run)"
  k wait kafka/kafka-source --for=condition=Ready --timeout=600s || {
    err "kafka-source did not become Ready"
    say "  kubectl -n $NS get pods"
    exit 1; }
  k wait kafka/kafka-target --for=condition=Ready --timeout=600s || {
    err "kafka-target did not become Ready"; exit 1; }

  info "Creating the source topic (12 partitions)"
  kubectl apply -f "$LAB_HOME/manifests/topic.yaml" >/dev/null

  info "Creating the SCRAM users for the security labs"
  kubectl apply -f "$LAB_HOME/manifests/users.yaml" >/dev/null
  # The user operator writes a Secret per KafkaUser; labs 13-15 read the
  # password out of it, so wait for them to exist.
  spin_until 240 "waiting for user secrets" \
    bash -c "kubectl -n $NS get secret kcd-replicator kcd-readonly >/dev/null 2>&1"

  info "Deploying the Connect cluster"
  kubectl apply -f "$LAB_HOME/manifests/connect.yaml" >/dev/null
  k wait kafkaconnect/"$CONNECT" --for=condition=Ready --timeout=600s || {
    err "KafkaConnect did not become Ready"
    say "  kubectl -n $NS get pods"
    say "  kubectl -n $NS describe kafkaconnect $CONNECT"
    exit 1; }

  info "Creating the baseline mirror connector"
  kubectl apply -f "$LAB_HOME/manifests/connector.yaml" >/dev/null
  wait_connector_tasks 1 180 || warn "connector tasks slow to appear; continuing"

  info "Exposing the Connect REST API through the ingress"
  if api_wait_controller 180; then
    # Applied only once the controller and its IngressClass exist; an Ingress
    # created before them is accepted but never routed.
    kubectl apply -f "$LAB_HOME/manifests/ingress.yaml" >/dev/null || \
      warn "Ingress apply failed"
    if api_start; then
      say "  ${C_GRN}ok${C_0}      $(api_curl_example)"
    else
      warn "ingress is up but the port-forward did not come alive; run: mirage api"
    fi
  else
    warn "ingress-nginx controller not ready; REST API not exposed. Retry with: mirage api"
  fi

  # Expose a broker on localhost:9092 so the host's own Kafka CLI works. The
  # /etc/hosts half needs root, so report what is still missing rather than
  # claiming it is usable.
  info "Exposing the source broker for host Kafka CLI tools"
  if kafka_pf_start source; then
    if kafka_hosts_entry_ok source; then
      say "  ${C_GRN}ok${C_0}      kafka-topics --bootstrap-server localhost:$KAFKA_PORT --list"
    else
      warn "forwarded, but add this once (needs sudo) or clients cannot follow the redirect:"
      say "    ${C_B}echo '127.0.0.1 $(kafka_advertised_host source)' | sudo tee -a /etc/hosts${C_0}"
    fi
  else
    warn "could not forward the Kafka broker; run: mirage kafka"
  fi

  info "Smoke test: producing 2000 records and checking they replicate"
  produce 2000 1000 2000
  local n=0 tgt=0
  while [ "$n" -lt 120 ]; do
    tgt="$(tgt_count)"
    [ "${tgt:-0}" -ge 1500 ] && break
    sleep 5; n=$((n+5))
  done

  say ""
  hr
  if [ "${tgt:-0}" -ge 1500 ]; then
    say "${C_GRN}${C_B}  Environment ready.  ${C_0}"
    say "  source=$(src_count)  target=$tgt"
  else
    warn "Smoke test inconclusive (target=$tgt). Inspect with: mirage status"
  fi
  hr
  say ""
  say "${C_B}Point this shell at the lab cluster${C_0} ${C_DIM}(for raw kubectl)${C_0}"
  say ""
  say "  ${C_B}eval \"\$(./mirage env --export)\"${C_0}"
  say ""
  say "${C_DIM}Namespace '$NS' is already pinned in that kubeconfig, so plain"
  say "'kubectl get kafkaconnector' works. mirage's own commands never need it.${C_0}"
  say ""
  say "${C_B}Connect REST API${C_0} ${C_DIM}(read-only, like production)${C_0}"
  say ""
  say "  ${C_B}$(api_curl_example)${C_0}"
  say "  ${C_B}mirage api /connectors${C_0}   ${C_DIM}# same thing, without the header${C_0}"
  say ""
  say "Next:"
  say "  ${C_B}mirage intro${C_0}      how the labs work"
  say "  ${C_B}mirage list${C_0}       see the labs"
  say "  ${C_B}mirage start 1${C_0}    begin"
}

# ----------------------------------------------------------------------- list

cmd_list() {
  hr
  say "${C_B}Mirage incident-response labs${C_0}"
  hr
  printf '%-4s %-46s %-9s %s\n' "n" "scenario" "level" "result"
  hr
  local n
  for n in $(all_lab_numbers); do
    load_lab "$n"
    local res icon
    res="$(lab_result "$n")"
    case "$res" in
      pass) icon="${C_GRN}PASS${C_0}" ;;
      fail) icon="${C_RED}fail${C_0}" ;;
      *)    icon="${C_DIM}-${C_0}" ;;
    esac
    printf '%-4s %-46s %-9s %b\n' "$n" "$LAB_TITLE" "$LAB_DIFFICULTY" "$icon"
  done
  hr
  local active
  active="$(get_active)"
  if [ -n "$active" ]; then
    say "Lab ${C_B}$active${C_0} is currently active. Grade it with: ${C_B}mirage stop $active${C_0}"
  else
    say "Start one with: ${C_B}mirage start <n>${C_0}"
  fi
}

# ---------------------------------------------------------------------- start

cmd_start() {
  local n="${1:-}"
  [ -z "$n" ] && { err "Usage: mirage start <n>"; exit 1; }
  require_cluster
  load_lab "$n"

  local active
  active="$(get_active)"
  if [ -n "$active" ] && [ "$active" != "$n" ]; then
    warn "Lab $active is still active. Resetting to a clean baseline first."
    cmd_reset quiet
  fi

  hr
  # Number and level only: the title names the cause too often (lab 3's is the
  # whole answer). It is shown again once you grade, in stop/solve/why.
  say "${C_B}LAB $n${C_0}  ${C_DIM}[$LAB_DIFFICULTY]${C_0}"
  hr
  info "Restoring a clean baseline"
  k delete resourcequota mirage-quota >/dev/null 2>&1 || true
  k patch kafkanodepool source-pool --type json \
    -p '[{"op":"remove","path":"/spec/template/pod/affinity"}]' >/dev/null 2>&1 || true
  forget_broker_pods
  # Delete connectors a previous lab renamed or added. restore_baseline brings
  # the real one back, but it does NOT remove these, and a survivor silently
  # breaks grading: it keeps mirroring lab-orders, so the throughput assertion
  # every lab_check ends with passes on someone else's work while this lab's own
  # connector is absent or dead. Seen for real: lab 4's `lab-orders-renamed`
  # outlived its lab and lab 3 then graded 'tasks running: 0' alongside
  # 'records replicate: 2000 >= 1600'.
  k delete kafkaconnector lab-loopback lab-stray lab-orders-renamed \
    lab-orders-recovered --wait=true >/dev/null 2>&1 || true
  restore_baseline
  clean_replicated_junk

  # Start the lab on a worker whose log is empty, so a plain `kubectl logs`
  # shows only this lab. Before settle_connector, so the replacement worker is
  # what gets waited on.
  #
  # ~50s, and it exists purely for the HUMAN reading raw `kubectl logs` — every
  # grader reads through worker_log, which is epoch-scoped and correct either
  # way (audited: the only `kubectl logs` strings inside a lab_check are
  # remediation hints, not reads). So the regression harness, which has no human
  # and runs this 17 times, sets MIRAGE_SKIP_RECYCLE=1 and saves ~14 minutes a
  # run. Never set it in an interactive session: the trainee's own
  # `kubectl logs mirage-connect-0` would then show the previous lab's errors.
  if [ "${MIRAGE_SKIP_RECYCLE:-0}" = "1" ]; then
    info "Skipping the worker recycle (MIRAGE_SKIP_RECYCLE=1; graders are epoch-scoped)"
  elif ! recycle_connect_worker; then
    warn "the Connect worker did not come back after recycling."
    warn "Older entries may still be from a previous lab. mirage logs --errors is scoped."
  fi

  if ! settle_connector 180; then
    warn "baseline did not settle; the injected fault may not behave as described."
    warn "If this lab misbehaves, run: mirage reset && mirage verify"
  fi

  # Clear per-lab scratch state, but keep the recorded result so `list` still
  # shows what you have passed before.
  local prev_result
  prev_result="$(lab_result "$n")"
  rm -f "$STATE_DIR"/lab"$n".* 2>/dev/null
  [ "$prev_result" = "pass" ] && record_pass "$n"
  unmark lab8.answer

  say ""
  info "Injecting the fault"
  # Keep the Kafka forward alive across labs. Several labs replace broker or
  # worker pods, which drops a pod-targeted forward silently — so re-establish
  # it rather than leaving a dead port behind. Default to source on a cold
  # start; otherwise keep whichever side the user chose.
  kafka_pf_start "$(kafka_pf_side)" >/dev/null 2>&1 || \
    kafka_pf_start source >/dev/null 2>&1 || true

  # Draw the log boundary here, after the baseline settled and before anything
  # is broken. Everything the worker logged for a previous lab is now out of
  # scope for both the graders and `mirage logs` — see log_epoch_set.
  log_epoch_set
  # A lab that cannot build its fault (e.g. a missing credential) must not be
  # presented as started — you would be hunting a fault that is not there, and
  # no fix could pass the grade.
  if ! lab_break; then
    say ""
    err "Lab $n was not injected. Nothing has been broken."
    say "  Fix the problem above, then run ${C_B}mirage start $n${C_0} again."
    clear_active
    log_epoch_clear
    exit 1
  fi
  set_active "$n"

  say ""
  hr
  lab_brief
  hr
  say ""
  say "${C_DIM}Production alert this maps to:${C_0} $LAB_ALERT"
  say ""
  say "Commands: ${C_B}mirage counts${C_0} | ${C_B}mirage topics${C_0} | ${C_B}mirage logs${C_0} | ${C_B}mirage hint $n${C_0}"
}

# ----------------------------------------------------------------------- stop

cmd_stop() {
  local n="${1:-$(get_active)}" active
  [ -z "$n" ] && { err "No active lab. Usage: mirage stop <n>"; exit 1; }

  # Refuse to grade a lab that is not the one running.
  #
  # Grading the wrong lab is not a harmless mistake: the environment holds the
  # ACTIVE lab's fault, so the requested lab gets graded against a fault that
  # was never injected for it. That produces a contradictory report — observed
  # for real: `stop 3` while lab 4 was active reported "autoRestart unset" and
  # "tasks running: 0" (lab 4 had deleted and renamed the connector lab 3
  # grades) next to "records replicate 2000 >= 1600" (lab 4's connector was
  # doing the mirroring). Nothing in that output points at the real problem,
  # which is that the wrong lab was graded.
  #
  # It also overwrites that lab's recorded result with a meaningless FAIL.
  # MIRAGE_FORCE_STOP bypasses both guards below. The regression harness grades
  # deliberately and twice per lab, and a PASS clears `active` — so after a
  # pre-fix FALSE pass the post-fix call would hit the "nothing active" guard
  # and report a missing lab instead of the false-pass it exists to detect. The
  # harness knows which lab it injected; a human does not need this.
  if [ "${MIRAGE_FORCE_STOP:-0}" != "1" ]; then
    active="$(get_active)"

    if [ -n "$active" ] && [ "$n" != "$active" ]; then
      err "Lab $active is the active lab, not lab $n."
      say ""
      say "  The cluster holds lab ${C_B}$active${C_0}'s fault, so grading lab $n would check it"
      say "  against a fault that was never injected: the report would be"
      say "  contradictory and lab $n would be recorded as failed."
      say ""
      say "  Grade the active lab:  ${C_B}mirage stop $active${C_0}"
      say "  Or switch labs:        ${C_B}mirage reset${C_0} then ${C_B}mirage start $n${C_0}"
      exit 1
    fi

    # Nothing active: the cluster is at its baseline, so there is no fault to
    # find. Many checks pass against a healthy environment — every throughput
    # assertion does — so this would report a partial or full PASS for work
    # that was never done.
    if [ -z "$active" ]; then
      err "No lab is active, so there is nothing to grade."
      say ""
      say "  The cluster is at its baseline. Grading lab $n now would check a"
      say "  healthy environment and could report a PASS you did not earn."
      say ""
      say "  Start it first:  ${C_B}mirage start $n${C_0}"
      say "  See status:      ${C_B}mirage status${C_0}"
      exit 1
    fi
  fi

  require_cluster
  load_lab "$n"

  hr
  say "${C_B}Grading lab $n — $LAB_TITLE${C_0}"
  hr
  mark "lab$n.attempted" 1
  reset_assertions
  grade_start_set
  lab_check
  say ""

  if report_result "$n"; then
    record_pass "$n"
    clear_active
    say ""
    say "Debrief: ${C_B}mirage why $n${C_0}  ${C_DIM}(what was really happening, and the rule)${C_0}"
    say "Then reset with ${C_B}mirage reset${C_0}, or go on with ${C_B}mirage next${C_0}."
    exit 0
  else
    record_fail "$n"
    exit 1
  fi
}

# ------------------------------------------------------------- hint / solve

cmd_hint() {
  local n level
  # Accept `hint`, `hint 7`, `hint 7 2`, and `hint 2` while a lab is active.
  if [ -n "${1:-}" ] && [ -n "${2:-}" ]; then
    n="$1"; level="$2"
  elif [ -n "${1:-}" ] && [ -n "$(get_active)" ] && [ "$1" != "$(get_active)" ] \
       && [ "$1" -le 9 ] 2>/dev/null && ! lab_file "$1" >/dev/null 2>&1; then
    n="$(get_active)"; level="$1"
  elif [ -n "${1:-}" ]; then
    n="$1"; level=""
  else
    n="$(get_active)"; level=""
  fi
  [ -z "$n" ] && { err "Usage: mirage hint <lab> [level]"; exit 1; }
  load_lab "$n"

  # Hints are written as blank-line-separated blocks, ordered general to
  # specific. Reveal them a block at a time so a nudge stays a nudge: dumping
  # the whole thing spends the hint in one go and often gives the answer away.
  local total text
  text="$(lab_hint)"
  total="$(printf '%s\n' "$text" | awk 'BEGIN{n=1;seen=0} /^[[:space:]]*$/{if(seen){n++;seen=0};next} {seen=1} END{print (seen? n : n-1)}')"
  [ -z "$total" ] || [ "$total" -lt 1 ] 2>/dev/null && total=1

  if [ -z "$level" ]; then level=$(( $(marked "lab$n.hintlevel" 2>/dev/null || echo 0) + 1 )); fi
  [ "$level" -lt 1 ] 2>/dev/null && level=1
  [ "$level" -gt "$total" ] && level="$total"
  mark "lab$n.hintlevel" "$level"

  hr; say "${C_B}Hint — lab $n${C_0}  ${C_DIM}(step $level of $total)${C_0}"; hr
  printf '%s\n' "$text" | awk -v want="$level" '
    BEGIN{n=1;seen=0}
    /^[[:space:]]*$/{ if(seen){n++;seen=0}; if(n<=want) print; next }
    { seen=1; if(n<=want) print }'
  say ""
  if [ "$level" -lt "$total" ]; then
    say "${C_DIM}More:${C_0} ${C_B}mirage hint $n $((level+1))${C_0}   ${C_DIM}(or just${C_0} mirage hint $n ${C_DIM}again)${C_0}"
  else
    say "${C_DIM}That is every hint.${C_0} Full answer: ${C_B}mirage solve $n${C_0}"
  fi
}

cmd_solve() {
  local n="${1:-$(get_active)}"
  [ -z "$n" ] && { err "Usage: mirage solve <n>"; exit 1; }
  load_lab "$n"

  # Not a gate — you can always read the answer. But if you have not graded an
  # attempt yet, point at the cheaper options first: a failed grade tells you
  # which half is wrong, and that is most of the learning.
  if [ -z "$(marked "lab$n.attempted")" ] && [ "$(lab_result "$n")" != "pass" ]; then
    warn "You have not graded an attempt at lab $n yet."
    say ""
    say "  Before the full answer, these cost less and teach more:"
    say "    ${C_B}mirage diff${C_0}      what the fault actually changed"
    say "    ${C_B}mirage stop $n${C_0}    grade an attempt — the failures name the gap"
    say "    ${C_B}mirage hint $n${C_0}    one nudge at a time"
    say ""
    printf '  Show the full solution anyway? [y/N] '
    local reply=""
    read -r reply 2>/dev/null || reply=y   # non-interactive: just show it
    case "$reply" in
      y|Y|yes|YES) ;;
      *) say ""; say "Nothing shown. Try ${C_B}mirage hint $n${C_0} first."; return 0 ;;
    esac
    say ""
  fi

  hr; say "${C_B}Solution — lab $n: $LAB_TITLE${C_0}"; hr
  lab_solve
  say ""
  warn "Having read this, re-run 'mirage stop $n' to confirm you applied it."
}

# --------------------------------------------------------------- inspection

# Difficulty-ordered path through the labs, not numeric order.
# Connector-focused faults first, then security, then cluster/platform, with the
# multi-fault exam last. Lab 16 sits after 10 because it needs the SMT/converter
# grounding that 9 and 10 build, and before the cluster labs.
LAB_ORDER="1 9 5 2 10 15 13 14 3 6 8 16 18 17 4 7 11 19 12"

cmd_next() {
  local n
  for n in $LAB_ORDER; do
    if [ "$(lab_result "$n")" != "pass" ]; then
      load_lab "$n"
      hr
      say "${C_B}Next up: LAB $n${C_0}  ${C_DIM}[$LAB_DIFFICULTY]${C_0}"
      hr
      say "  ${C_B}mirage start $n${C_0}"
      return 0
    fi
  done
  hr
  local n_labs
  n_labs="$(printf '%s\n' $LAB_ORDER | grep -c .)"
  say "${C_GRN}${C_B}  All $n_labs labs passed.  ${C_0}"
  hr
