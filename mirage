cmd_logs() {
  require_cluster
  local pod
  pod="$(connect_pod)"
  [ -z "$pod" ] && { err "No Connect pod found"; exit 1; }

  # `logs --errors` filters to the patterns the on-call log cookbook lists, so
  # the same greps you would reach for in production are the ones you practise
  # here. Plain `logs` keeps following the stream as before.
  if [ "${1:-}" = "--errors" ] || [ "${1:-}" = "-e" ]; then
    local lines="${2:-2000}" epoch
    epoch="$(log_epoch)"
    # Scoped to the active lab, so a signature the PREVIOUS lab left in the
    # worker's log is not presented as evidence about this one.
    if [ -n "$epoch" ]; then
      info "Scanning $pod for known failure signatures since this lab started"
    else
      info "Scanning the last $lines lines of $pod for known failure signatures"
    fi
    say ""
    local out
    out="$(worker_log "$lines" | grep -nE \
      'ERROR|^Caused by:|RecordTooLargeException|InvalidTimestampException|OutOfMemoryError|SaslAuthenticationException|TopicAuthorizationException|SSLHandshakeException|keystore password was incorrect|Authentication failed|Not authorized|DataException|ConnectException|Cancelled in-flight FETCH|socket connection setup timeout|Error setting zookeeper data|Received exception when fetching|Maximum number of metrics reached|rebalance')"
    if [ -z "$out" ]; then
      if [ -n "$epoch" ]; then
        say "  ${C_GRN}no known failure signatures since this lab started${C_0}"
      else
        say "  ${C_GRN}no known failure signatures in the last $lines lines${C_0}"
      fi
      say ""
      say "  ${C_DIM}That does not mean healthy — a stale connector logs nothing at all."
      say "  Check throughput with: mirage counts${C_0}"
      return 0
    fi
    printf '%s\n' "$out" | cut -c1-200 | sed 's/^/  /'
    say ""
    say "${C_B}What these mean${C_0}"
    printf '%s\n' "$out" | grep -qE 'SaslAuthenticationException|Authentication failed' && \
      say "  ${C_YEL}SaslAuthenticationException${C_0}  bad credentials. TLS already succeeded."
    printf '%s\n' "$out" | grep -q 'TopicAuthorizationException' && \
      say "  ${C_YEL}TopicAuthorizationException${C_0} credentials are VALID — an ACL is missing."
    printf '%s\n' "$out" | grep -qE 'SSLHandshakeException|keystore password' && \
      say "  ${C_YEL}SSLHandshakeException${C_0}      truststore problem; SASL never ran."
    printf '%s\n' "$out" | grep -q 'RecordTooLargeException' && \
      say "  ${C_YEL}RecordTooLargeException${C_0}    the TARGET refused a record over its size limit (lab 16)."
    printf '%s\n' "$out" | grep -q 'InvalidTimestampException' && \
      say "  ${C_YEL}InvalidTimestampException${C_0}  the TARGET refused a record's timestamp (lab 18)."
    printf '%s\n' "$out" | grep -q 'Unrecoverable exception from producer send callback' && \
      say "  ${C_YEL}Unrecoverable ... send callback${C_0}  that task is FAILED; only its partitions stop."
    printf '%s\n' "$out" | grep -q 'OutOfMemoryError' && \
      say "  ${C_YEL}OutOfMemoryError${C_0}           heap too small for the workload (lab 3)."
    printf '%s\n' "$out" | grep -q 'DataException' && \
      say "  ${C_YEL}DataException${C_0}              converter/SMT mismatch (lab 9/10)."
    printf '%s\n' "$out" | grep -qE 'Cancelled in-flight FETCH|socket connection setup timeout' && \
      say "  ${C_YEL}fetch/socket timeouts${C_0}      broker-side or network, not the connector."
    if printf '%s\n' "$out" | grep -q 'replication-target-admin'; then
      say ""
      say "  ${C_DIM}Note: 'replication-target-admin' in the thread name means the failure is"
      say "  on the mirror's admin client — tasks can stay RUNNING while nothing moves.${C_0}"
    fi
    return 0
  fi

  # A follow is live output, so a tail of it cannot contain a previous lab's
  # errors for long — but the first screenful can. Start the stream at the
  # epoch when a lab is active.
  local epoch
  epoch="$(log_epoch)"
  info "Tailing $pod (Ctrl-C to stop).  Tip: mirage logs --errors"
  if [ -n "$epoch" ]; then
    k logs -f "$pod" --since-time="$epoch" --tail="${1:-80}"
  else
    k logs -f "$pod" --tail="${1:-80}"
  fi
}

# ---- why: the debrief you would otherwise only see inside `solve` ----
# Fixing a lab yourself means never reading its solve, so the mechanism, the
# production equivalent and the transferable rule all go unread by exactly the
# people who earned them. `why` is that debrief, separated from the answer.
cmd_why() {
  local n="${1:-$(get_active)}"
  [ -z "$n" ] && { err "Usage: mirage why <n>"; exit 1; }
  load_lab "$n"
  # shellcheck disable=SC1091
  source "$LAB_HOME/lib/debriefs.sh"
  why_lab "$n"

  if [ -z "$WHY_MECHANISM$WHY_SIGNAL$WHY_PROD$WHY_RULE" ]; then
    warn "No debrief written for lab $n yet."
    say "Its teaching notes are inside ${C_B}mirage solve $n${C_0}."
    return 0
  fi

  hr; say "${C_B}Debrief — lab $n: $LAB_TITLE${C_0}"; hr

  _why_block() {   # $1 = heading, $2 = body
    [ -z "$2" ] && return 0
    say ""
    say "${C_B}$1${C_0}"
    # The source text is hard-wrapped already, so collapse it to one line first
    # and re-flow; folding it as-is double-wraps and leaves ragged stubs.
    printf '%s' "$2" | tr '\n' ' ' | tr -s ' ' | fold -s -w 74 \
      | sed 's/[[:space:]]*$//' | sed 's/^/  /'
    printf '\n'
  }

  _why_block "What was actually happening" "$WHY_MECHANISM"
  _why_block "How it shows up" "$WHY_SIGNAL"
  _why_block "At MirageDuel" "$WHY_PROD"

  if [ -n "$WHY_RULE" ]; then
    say ""
    say "${C_B}The rule worth keeping${C_0}"
    printf '%s\n' "$WHY_RULE" | tr '\n' ' ' | tr -s ' ' | fold -s -w 72 \
      | sed 's/[[:space:]]*$//' | sed "s/^/  ${C_GRN}>${C_0} /"
  fi

  say ""
  say "${C_DIM}Alert this maps to:${C_0} $LAB_ALERT"
  say ""
  local nxt
  nxt="$(marked "lab$n.result" >/dev/null 2>&1; echo "")"
  if [ "$(lab_result "$n")" = "pass" ]; then
    say "${C_DIM}Next:${C_0} ${C_B}mirage next${C_0}"
  else
    say "${C_DIM}You have not passed this lab yet — ${C_0}${C_B}mirage start $n${C_0}${C_DIM} to try it.${C_0}"
  fi
  unset -f _why_block
}

