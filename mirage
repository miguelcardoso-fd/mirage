}

cmd_verify() {
  require_cluster
  hr; say "${C_B}Environment verification${C_0}"; hr
  reset_assertions

  assert_ge "Strimzi operator running" \
    "$(kq get deploy strimzi-cluster-operator -o jsonpath='{.status.readyReplicas}' || echo 0)" 1 \
    "Nothing reconciles without the operator." "kubectl -n $NS get deploy strimzi-cluster-operator"

  local sready tready
  sready="$(kq get kafka kafka-source -o jsonpath='{range .status.conditions[?(@.type=="Ready")]}{.status}{end}')"
  tready="$(kq get kafka kafka-target -o jsonpath='{range .status.conditions[?(@.type=="Ready")]}{.status}{end}')"
  assert_eq "source Kafka cluster Ready" "${sready:-missing}" "True" \
    "Labs replicate source -> target; without the source there is nothing to mirror." \
    "kubectl -n $NS get kafka kafka-source"
  assert_eq "target Kafka cluster Ready" "${tready:-missing}" "True" \
    "The mirror writes here." "kubectl -n $NS get kafka kafka-target"

  assert "source broker pod discoverable" "$([ -n "$(src_pod)" ] && echo 0 || echo 1)" \
    "Helpers exec into the broker to count records." \
    "kubectl -n $NS get pods -l strimzi.io/broker-role=true"
  assert "target broker pod discoverable" "$([ -n "$(tgt_pod)" ] && echo 0 || echo 1)" \
    "Same." "kubectl -n $NS get pods -l strimzi.io/broker-role=true"

  local cready
  cready="$(kq get kafkaconnect "$CONNECT" -o jsonpath='{range .status.conditions[?(@.type=="Ready")]}{.status}{end}')"
  assert_eq "KafkaConnect cluster Ready" "${cready:-missing}" "True" \
    "Workers host the connector tasks." "kubectl -n $NS get kafkaconnect"

  assert_ge "at least one Connect worker Running" "$(ready_connect_pods)" 1 \
    "" "kubectl -n $NS get pods -l strimzi.io/cluster=$CONNECT"

  assert_ge "source topic has 12 partitions" \
    "$(topic_partitions "$(src_pod)" "$SRC_BOOT" "$TOPIC")" 12 \
    "Lab 1 depends on a 12-partition topic." \
    "kubectl -n $NS get kafkatopic $TOPIC"

  assert "connector exists" "$(conn_exists && echo 0 || echo 1)" \
    "The baseline connector is what every lab breaks." \
    "kubectl -n $NS get kafkaconnector"

  assert_ge "connector has running tasks" "$(conn_task_count RUNNING)" 1 \
    "" "kubectl -n $NS describe kafkaconnector $CONNECTOR"

  # Labs 13-15 build their fault out of these passwords. If the Secrets are
  # missing the labs would inject password="" and be unwinnable, so surface it
  # here rather than three labs later.
  local u
  for u in kcd-replicator kcd-readonly; do
    assert "SCRAM user $u has a readable password" \
      "$([ -n "$(scram_password "$u")" ] && echo 0 || echo 1)" \
      "Security labs 13-15 cannot be injected without it. Apply manifests/users.yaml and wait for the user operator." \
      "kubectl -n $NS get kafkauser $u; kubectl -n $NS get secret $u"
  done
  assert "target cluster CA password readable" \
    "$([ -n "$(target_ca_password)" ] && echo 0 || echo 1)" \
    "The TLS lab's truststore password comes from here." \
    "kubectl -n $NS get secret kafka-target-cluster-ca-cert"

  # The CR is desired state; the REST API is what the worker is running. They
  # diverge when Connect rejects a config (400) or refuses one mid-rebalance
  # (500), and every health signal can look fine while they disagree.
  local cr_topics rt_topics
  cr_topics="$(conn_get '.spec.config.topics')"
  rt_topics="$(runtime_config_value topics)"
  assert_eq "CR and runtime config agree" "${rt_topics:-unreachable}" "${cr_topics:-unset}" \
    "If these differ, the operator could not push config to Connect — usually a rejected config or a blocked rebalance. Fix the worker cluster, not the connector." \
    "kubectl -n $NS get kafkaconnector $CONNECTOR -o jsonpath='{.spec.config.topics}' vs mirage api /connectors/$CONNECTOR/config"

  assert "JMX metrics endpoint responding on :9404" \
    "$([ -n "$(metric 'kafka_connect_worker')" ] && echo 0 || echo 1)" \
    "Metric names here match production; several labs ask you to read them." \
    "mirage metrics"

  # Reported, never asserted. The ingress is an operator convenience: no lab
  # grades through it, and a dead port-forward must not read as a broken
  # environment.
  #
  # api_start rather than api_up: a no-op when the path is healthy, and
  # otherwise one restart attempt, so what gets reported is a real failure
  # rather than a forward that merely died while the laptop slept.
  if api_start >/dev/null 2>&1; then
    say "  ${C_GRN}ok${C_0}      Connect REST API reachable — $(api_curl_example)"
  else
    warn "Connect REST API not reachable from the host (not a lab failure). Run: mirage api"
  fi

  # Same treatment for the Kafka forward: a convenience, never a lab failure.
  local kside; kside="$(kafka_pf_side)"
  [ -n "$kside" ] || kside=source
  if kafka_pf_start "$kside" >/dev/null 2>&1 && kafka_hosts_entry_ok "$kside"; then
    say "  ${C_GRN}ok${C_0}      Kafka CLI reachable — kafka-topics --bootstrap-server localhost:$KAFKA_PORT --list"
  elif kafka_hosts_entry_ok "$kside"; then
    warn "Kafka port-forward not up (not a lab failure). Run: mirage kafka"
  else
    warn "Kafka CLI needs a one-time hosts entry (not a lab failure):"
    say "    ${C_B}echo '127.0.0.1 $(kafka_advertised_host "$kside")' | sudo tee -a /etc/hosts${C_0}"
  fi

  info "End-to-end replication test (produces 500 records)"
  local before after n=0
  before="$(tgt_count)"
  produce 500 1000 500
  while [ "$n" -lt 90 ]; do
    after="$(tgt_count)"
    [ "${after:-0}" -ge $(( ${before:-0} + 400 )) ] && break
    sleep 5; n=$((n+5))
  done
  after="$(tgt_count)"
  assert_ge "records replicate source -> target" "$(( ${after:-0} - ${before:-0} ))" 400 \
    "This is the whole pipeline. If it fails, fix the environment before starting labs." \
    "mirage counts  (target went $before -> $after)"

  say ""
  if report_result "environment"; then
    say ""
    say "Environment is healthy. Start with: ${C_B}mirage start 1${C_0}"
    return 0
  fi
  say ""
  say "Try ${C_B}mirage reset${C_0}, or re-run ${C_B}mirage setup${C_0}."
  return 1
}

