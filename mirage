# ---- api: the Connect REST API, through the ingress ----
#
# With a path: GET it and print the body. Without: show how to reach it and
# whether the path is currently up.
#
# Either way this (re-)establishes the port-forward if it has died, which is
# why it is also the thing status/verify tell you to run. Auto-healing happens
# only here and in setup -- never silently in the middle of a lab.
cmd_api() {
  require_cluster
  local path="${1:-}"

  if ! kubectl -n "$API_NS" get deploy "$API_SVC" >/dev/null 2>&1; then
    err "ingress-nginx is not installed in this cluster."
    say "  Install it:  kubectl apply -f vendor/ingress-nginx-$INGRESS_NGINX_VERSION/deploy.yaml"
    say "  Or rebuild:  mirage setup"
    return 1
  fi
  # Both objects live in manifests/ingress.yaml. Check the NetworkPolicy too:
  # without it Strimzi's own policy blocks nginx and the only symptom is a 504
  # (or a timeout) while every backend signal reads healthy.
  if ! kq get ingress mirage-connect-api >/dev/null 2>&1 \
     || ! kq get networkpolicy mirage-connect-api-from-ingress >/dev/null 2>&1; then
    warn "The Ingress or its NetworkPolicy is missing; applying manifests/ingress.yaml"
    kubectl apply -f "$LAB_HOME/manifests/ingress.yaml" >/dev/null 2>&1 || {
      err "Ingress apply failed"; return 1; }
  fi

  if ! api_start; then
    err "Could not reach the Connect REST API."
    say ""
    say "  Controller:  kubectl -n $API_NS get pods"
    say "  Ingress:     kubectl -n $NS describe ingress mirage-connect-api"
    say "  Forward log: $(api_log_file)"
    say ""
    # Naming the PID is the difference between a dead end and a one-line fix:
    # the usual cause is a port-forward left over from a previous cluster, which
    # teardown could not record because it removed .state along with the pidfile.
    local holder; holder="$(api_port_holder)"
    if [ -n "$holder" ]; then
      say ""
      say "  Port $API_PORT is held by PID ${C_B}$holder${C_0}, which is not serving this cluster."
      say "  Free it with:  ${C_B}kill $holder${C_0}   then re-run ${C_B}mirage api${C_0}"
    else
      say "  ${C_DIM}Port $API_PORT may also be held by something else on this host.${C_0}"
    fi
    return 1
  fi

  if [ -n "$path" ]; then
    case "$path" in /*) ;; *) path="/$path" ;; esac
    api_curl "$path"
    # The body may not end in a newline (Connect's JSON does not), which would
    # otherwise glue the shell prompt onto the output.
    printf '\n'
    return 0
  fi

  hr; say "${C_B}Connect REST API${C_0}"; hr
  say ""
  say "  ${C_B}$(api_curl_example)${C_0}"
  say ""
  say "Or without the header:"
  say ""
  say "  ${C_B}mirage api /connectors${C_0}"
  say "  ${C_B}mirage api /connectors/$CONNECTOR/status${C_0}"
  say "  ${C_B}mirage api /connectors/$CONNECTOR/config${C_0}"
  say "  ${C_B}mirage api /connector-plugins${C_0}"
  say ""
  say "  ${C_GRN}reachable${C_0} on localhost:$API_PORT ${C_DIM}(host $API_HOST)${C_0}"
  say ""
  say "${C_DIM}Routed by Host header through a real Ingress and ingress-nginx, the"
  say "same shape as production. In production this API is READ-ONLY by"
  say "convention: mutate connectors through the KafkaConnector CR, never here,"
  say "or the operator reconciles your change away.${C_0}"
  say ""
}

# ---- kafka: expose a broker on localhost:9092 for the host's own CLI ----
#
# See kafka_pf_start in lib/common.sh for why this forwards a POD and needs an
# /etc/hosts entry: a Kafka client follows the broker's advertised listener,
# which is internal cluster DNS.
cmd_kafka() {
  require_cluster
  local side="${1:-source}"
  case "$side" in
    source|src)     side=source ;;
    target|tgt)     side=target ;;
    stop|off)       kafka_pf_stop; say "Kafka port-forward stopped."; return 0 ;;
    both|all)
      # Not possible without sudo, and saying so beats a forward that silently
      # serves the wrong cluster. Tested: both brokers advertise :9092, so a
      # second forward on :9093 bootstraps, learns the advertised :9092, and
      # reconnects to whichever forward holds that port. Querying the TARGET on
      # :9093 returned the SOURCE's topic list with no error at all.
      err "Both clusters cannot be forwarded at once."
      say ""
      say "  Both brokers advertise port ${C_B}9092${C_0}, and a Kafka client always"
      say "  reconnects to the advertised address. A second forward on another"
      say "  local port bootstraps fine and then redirects to :9092 — so it"
      say "  silently returns the OTHER cluster's data. Verified, not theory."
      say ""
      say "  Two real options:"
      say "    ${C_B}mirage kafka target${C_0}   switch sides (fast — no cluster change)"
      say "    ${C_B}sudo ifconfig lo0 alias 127.0.0.2${C_0}   then ask for a second address"
      say ""
      return 1 ;;
    status)
      local s; s="$(kafka_pf_side)"
      if [ -z "$s" ]; then say "No Kafka port-forward is running."; return 0; fi
      if kafka_pf_up "$s"; then
        # Confirm the far end is the cluster the records claim, not just that
        # something answers — a mislabelled forward is the failure this guards.
        local sc; sc="$(kafka_pf_cluster_id)"
        if [ -n "$sc" ] && [ "$sc" != "$(kafka_cluster_id "$s")" ]; then
          warn "recorded as $s, but localhost:$KAFKA_PORT serves cluster id $sc"
          say "  That is the ${C_B}other${C_0} cluster. Re-establish: ${C_B}mirage kafka $s${C_0}"
          return 1
        fi
        say "Forwarding ${C_B}$s${C_0} on localhost:$KAFKA_PORT ${C_DIM}(PID $(kafka_port_holder), cluster $sc)${C_0}"
      else
        warn "recorded as $s on localhost:$KAFKA_PORT, but it is NOT reachable."
        say "  Re-establish with: ${C_B}mirage kafka $s${C_0}"
      fi
      return 0 ;;
    *) err "Usage: mirage kafka [source|target|stop|status]"; return 1 ;;
  esac

  local host; host="$(kafka_advertised_host "$side")"

  if ! kafka_pf_start "$side"; then
    err "Could not forward the $side broker on localhost:$KAFKA_PORT."
    local holder; holder="$(kafka_port_holder)"
    if [ -n "$holder" ]; then
      say "  Port $KAFKA_PORT is held by PID ${C_B}$holder${C_0}."
      say "  Free it with:  ${C_B}kill $holder${C_0}   then re-run ${C_B}mirage kafka $side${C_0}"
    fi
    say "  Forward log: $(kafka_pf_log_file)"
    return 1
  fi

  hr; say "${C_B}Kafka CLI access — $side cluster${C_0}"; hr
  say ""

  # The hosts entry is the half that cannot be automated: /etc/hosts needs root.
  # Without it the forward binds and then every request fails with
  # UnknownHostException, so say so loudly rather than reporting success.
  if ! kafka_hosts_entry_ok "$side"; then
    warn "localhost:$KAFKA_PORT is forwarded, but your Kafka CLI will still fail."
    say ""
    say "  A client bootstraps, then reconnects to the name the broker advertises:"
    say "    ${C_DIM}$host${C_0}"
    say "  Your host cannot resolve that, so add it once (needs sudo):"
    say ""
    say "    ${C_B}echo '127.0.0.1 $host' | sudo tee -a /etc/hosts${C_0}"
    say ""
    say "  Then re-run ${C_B}mirage kafka $side${C_0}."
    say ""
    return 1
  fi

  # Prove it, do not assert it. `mirage kafka target` once printed
  # "ready -> target broker" over a forward that was serving the source, which
  # is the most expensive kind of wrong. The cluster id comes from the far end.
  local cid
  cid="$(kafka_pf_cluster_id)"
  if [ -n "$cid" ] && [ "$cid" != "$(kafka_cluster_id "$side")" ]; then
    err "localhost:$KAFKA_PORT is NOT serving the $side cluster."
    say ""
    say "  Expected cluster id ${C_B}$(kafka_cluster_id "$side")${C_0}, got ${C_B}$cid${C_0}."
    say "  Something else holds the port — most likely the other cluster's forward."
    say ""
    local holder; holder="$(kafka_port_holder)"
    [ -n "$holder" ] && say "  Free it with:  ${C_B}kill $holder${C_0}   then re-run ${C_B}mirage kafka $side${C_0}"
    say ""
    return 1
  fi

  say "  ${C_GRN}ready${C_0}   localhost:$KAFKA_PORT  ${C_DIM}-> $side broker${C_0}"
  [ -n "$cid" ] && say "  ${C_DIM}verified: cluster id $cid${C_0}"
  say ""
  say "From any terminal:"
  say ""
  say "  ${C_B}kafka-topics --bootstrap-server localhost:$KAFKA_PORT --describe --topic $TOPIC${C_0}"
  say "  ${C_B}kafka-topics --bootstrap-server localhost:$KAFKA_PORT --list${C_0}"
  say "  ${C_B}kafka-console-consumer --bootstrap-server localhost:$KAFKA_PORT --topic $TOPIC --max-messages 5${C_0}"
  say "  ${C_B}kafka-get-offsets --bootstrap-server localhost:$KAFKA_PORT --topic $TOPIC${C_0}"
  say ""
  say "Switch sides:  ${C_B}mirage kafka target${C_0} | ${C_B}mirage kafka source${C_0}"
  say ""
  # Both clusters advertise 9092, and a second loopback address needs
  # `sudo ifconfig lo0 alias`, so only one side can hold the port at a time.
  say "${C_DIM}Only one cluster at a time: both advertise port $KAFKA_PORT, so the forward"
  say "switches rather than running two. Stop it with: mirage kafka stop${C_0}"
  say ""
  say "To hit the OTHER cluster without switching, skip the forward entirely:"
  say "  ${C_B}mirage kcli target topics --list${C_0}"
  say "  ${C_B}mirage kcli source topics --describe --topic $TOPIC${C_0}"
  say ""
}

# ---- kcli: run a Kafka CLI tool against either cluster, no forward needed ----
#
# The port-forward can only serve one cluster (both advertise 9092), which makes
# "check the other side" needlessly disruptive. This execs the broker's own CLI
# inside the pod instead, so BOTH clusters are reachable at once and the
# advertised-listener problem does not arise at all.
#
# Usage: mirage kcli <source|target> <tool> [args...]
#   tool is a bin/kafka-<tool>.sh name without the prefix/suffix:
#     topics, get-offsets, configs, console-consumer, consumer-groups, ...
# --bootstrap-server is supplied automatically; passing one is an error, because
# a wrong value silently queries the wrong cluster.
cmd_kcli() {
  require_cluster
  local side="${1:-}" tool="${2:-}"
  case "$side" in
    source|src) side=source ;;
    target|tgt) side=target ;;
    *) err "Usage: mirage kcli <source|target> <tool> [args...]"
       say ""
       say "  ${C_B}mirage kcli target topics --list${C_0}"
       say "  ${C_B}mirage kcli source topics --describe --topic $TOPIC${C_0}"
       say "  ${C_B}mirage kcli target get-offsets --topic $TOPIC${C_0}"
       say ""
       say "  ${C_DIM}Runs the broker's own CLI in the pod, so both clusters are"
       say "  reachable at once — no port-forward and no switching.${C_0}"
       return 1 ;;
  esac
  [ -z "$tool" ] && { err "Which tool? e.g. 'topics', 'get-offsets', 'configs'"; return 1; }
  shift 2

  local pod boot
  if [ "$side" = "source" ]; then pod="$(src_pod)"; boot="$SRC_BOOT"
  else                            pod="$(tgt_pod)"; boot="$TGT_BOOT"
  fi
  [ -z "$pod" ] && { err "No $side broker pod found."; return 1; }

  # Refuse a caller-supplied bootstrap: the whole point is that the right one is
  # chosen for you, and a stale --bootstrap-server is how you end up reading the
  # other cluster and believing the result.
  local a
  for a in "$@"; do
    case "$a" in
      --bootstrap-server*)
        err "Do not pass --bootstrap-server; 'kcli $side' already targets $boot."
        return 1 ;;
    esac
  done

  # Refuse the one delete that wrecks the environment.
  #
  # Deleting the SOURCE lab-orders is not recoverable by the obvious means. The
  # KafkaTopic operator does NOT recreate it (tested: still absent after 60s),
  # `mirage reset --fresh` then reports "replication is NOT working", and the
  # worker can be left crashlooping. Recreating it by hand also risks the wrong
  # partition count — 12 is load-bearing for lab 1, and a 1-partition adoption
  # breaks labs silently. truncate_topic exists to do this correctly.
  if [ "$side" = "source" ] && [ "$tool" = "topics" ]; then
    local arg has_delete=0 names_topic=0
    for arg in "$@"; do
      case "$arg" in
        --delete) has_delete=1 ;;
        "$TOPIC") names_topic=1 ;;
      esac
    done
    if [ "$has_delete" = "1" ] && [ "$names_topic" = "1" ]; then
      err "Refusing to delete $TOPIC on the source cluster."
      say ""
      say "  It is managed by a KafkaTopic CR, and the operator does not bring it"
      say "  back — replication stops and the Connect worker can end up"
      say "  crashlooping. Recreating it by hand also risks the wrong partition"
      say "  count; ${C_B}12${C_0} is load-bearing for lab 1."
      say ""
      say "  To empty and rebuild it correctly:  ${C_B}mirage reset --fresh${C_0}"
      say ""
      return 1
    fi
  fi

  # Header on stderr so stdout pipes cleanly:
  #   for t in $(mirage kcli target topics --list | grep mm2); do ...
  say "${C_DIM}# $side cluster ($boot)${C_0}" >&2
  kq exec "$pod" -c kafka -- "bin/kafka-$tool.sh" --bootstrap-server "$boot" "$@"
}

# ---- intro: a guided first run so lab 1 is not a cold start ----
cmd_intro() {
  hr; say "${C_B}How these labs work${C_0}"; hr
  cat <<'EOF'

Each lab breaks something in a running Kafka Connect mirror, then grades whether
you fixed it. Nothing is simulated: there are two real Kafka clusters, a real
Strimzi-managed Connect worker, and a real MirrorSourceConnector between them.

RAW kubectl NEEDS THE LAB KUBECONFIG

  Every mirage command sets it for you. Raw kubectl does not, so it talks to
  whatever your shell points at — and you will see "No resources found":

    eval "$(./mirage env --export)"

  The namespace is pinned to mirage inside that kubeconfig, so you do not need
  -n mirage either. The pinning is deliberate: it is what stops a lab touching a
  real cluster.

THE LOOP

  mirage start 1     inject the fault and print the symptom
  ...                 diagnose and fix it with kubectl
  mirage stop 1      grade your fix

WHAT YOU GET WHEN YOU ARE STUCK

  mirage diff        baseline vs running state, and CR vs worker runtime.
                      Start here. It is the on-call reflex worth building.
  mirage status      pods, CRs, task states at a glance
  mirage counts      is data actually moving? (measures a live delta)
  mirage logs -e     only the log lines that matter, with what they mean
  mirage hint 1      one nudge. Run it again for the next one.
  mirage solve 1     the full answer, once you want it

IF THE ENVIRONMENT ITSELF LOOKS BROKEN

  mirage verify      16 checks that separate "my fix is wrong" from
                      "the cluster is unhappy"
  mirage reset       put the baseline back
  mirage repair      rebuild Connect when things are properly wedged

TWO THINGS THAT WILL SAVE YOU TIME

  1. A grade that fails only on throughput is often just slow recovery. A
     connector coming back from UNASSIGNED can take ~2 minutes. Wait, then
     re-run stop before assuming the fix was wrong.

  2. Green task state is not a working pipeline. Several labs leave every task
     RUNNING while no data moves at all — that is the point of them. Always
     confirm with mirage counts.

EOF
  say "Ready: ${C_B}mirage start 1${C_0}   ${C_DIM}(or mirage list to see all 19)${C_0}"
  say ""
}

