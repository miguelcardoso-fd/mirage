# -------------------------------------------------------------------- reset

cmd_reset() {
  local quiet="" fresh=""
  while [ $# -gt 0 ]; do
    case "$1" in
      quiet)            quiet=quiet ;;
      --fresh|fresh)    fresh=1 ;;
    esac
    shift
  done
  require_cluster
  [ "$quiet" != "quiet" ] && info "Restoring the baseline"

  if [ -n "$fresh" ]; then
    info "Truncating $TOPIC (dropping accumulated records)"
    truncate_topic
  fi

  k delete resourcequota mirage-quota >/dev/null 2>&1 || true

  # Undo lab 8's broker severing (impossible node affinity on the source pool).
  k patch kafkanodepool source-pool --type json \
    -p '[{"op":"remove","path":"/spec/template/pod/affinity"}]' >/dev/null 2>&1 || true
  k patch kafkanodepool source-pool --type merge -p '{"spec":{"replicas":1}}' >/dev/null 2>&1 || true
  k patch kafkanodepool target-pool --type merge -p '{"spec":{"replicas":1}}' >/dev/null 2>&1 || true
  forget_broker_pods

  # Undo lab 7/12's loopback connectors and any renamed survivors.
  k delete kafkaconnector lab-loopback lab-stray lab-orders-renamed \
    lab-orders-recovered >/dev/null 2>&1 || true

  # Lab 3/12 may leave the worker sized so it cannot start; restore_baseline
  # reapplies the manifest, which fixes that.
  restore_baseline
  clean_replicated_junk
  clear_active
  # No lab is active, so no log window applies; the next `start` sets a new one.
  log_epoch_clear

  # Verify, and self-heal once if the baseline is genuinely dead. Reporting
  # "restored" while nothing replicates is worse than reporting failure.
  local healthy=0 attempt
  for attempt in 1 2; do
    if settle_connector 180 && [ "$(replication_delta 600 90)" -ge 400 ]; then
      healthy=1; break
    fi
    [ "$attempt" -eq 2 ] && break
    warn "Baseline is not replicating — recreating the Connect cluster"
    recreate_connect_cluster
    restore_baseline
  done

  if [ "$quiet" != "quiet" ]; then
    say ""
    cmd_counts
    say ""
    if [ "$healthy" -eq 1 ]; then
      say "${C_GRN}Baseline restored and replicating.${C_0} ${C_B}mirage next${C_0}"
    else
      err "Baseline restored but replication is NOT working."
      say "  Diagnose with: ${C_B}mirage verify${C_0}"
      say "  If that fails too: ${C_B}mirage teardown && mirage setup${C_0}"
      return 1
    fi
  fi
  [ "$healthy" -eq 1 ] || return 1
  return 0
}

cmd_repair() {
  require_cluster
  hr; say "${C_B}Repairing the Connect cluster${C_0}"; hr
  say "Use this when the environment is wedged: no Connect pod, a worker stuck"
  say "with zero tasks, or replication dead after a lab. Rebuilds the Connect"
  say "cluster and its internal topics from scratch. Kafka data is untouched."
  say ""

  k delete resourcequota mirage-quota >/dev/null 2>&1 || true
  k patch kafkanodepool source-pool --type json \
    -p '[{"op":"remove","path":"/spec/template/pod/affinity"}]' >/dev/null 2>&1 || true
  forget_broker_pods

  info "Recreating the Connect cluster (up to 7 minutes)"
  recreate_connect_cluster

  info "Restoring the baseline connector"
  restore_baseline
  clean_replicated_junk
  clear_active

  # recreate_connect_cluster deletes the KafkaConnect CR, so Strimzi deletes and
  # recreates the connect-api Service under the Ingress. The Ingress itself
  # survives (it binds by name), but nginx's endpoints churn and the forward may
  # have been serving across the gap -- re-establish it.
  #
  # Before the success/failure branch deliberately: the failure path sends you to
  # `mirage verify`, which reports REST API reachability, so the forward has to
  # be back up in BOTH outcomes.
  api_start >/dev/null 2>&1 || warn "REST API not reachable after repair; run: mirage api"
  # Re-establish the Kafka forward too: repair replaces pods, which drops it.
  kafka_pf_start "$(kafka_pf_side)" >/dev/null 2>&1 || true

  if settle_connector 180 && [ "$(replication_delta 600 90)" -ge 400 ]; then
    say ""
    say "${C_GRN}${C_B}  Repaired and replicating.  ${C_0}"
    cmd_counts
    return 0
  fi

  say ""
  err "Repair did not restore replication."
  say "  Run ${C_B}mirage verify${C_0} to see which layer is broken,"
  say "  or rebuild from scratch: ${C_B}mirage teardown && mirage setup${C_0}"
  return 1
}

cmd_teardown() {
  local provider
  provider="$(provider_saved || provider_detect)" || {
    err "Cannot tell which provider owns this cluster, and no provider is installed."
    exit 1; }
  say "This deletes the $provider cluster '$LAB_CLUSTER' and everything in it."
  printf 'Type %sdelete%s to confirm: ' "$C_B" "$C_0"
  local reply; read -r reply
  if [ "$reply" != "delete" ]; then say "Aborted."; exit 0; fi
  # Kill the port-forwards before the cluster goes: kubectl would otherwise be
  # left retrying against an API server that no longer exists. Both must go, or
  # the survivor holds its port against a namespace that no longer exists --
  # which is the orphan case kafka_pf_stop_orphan then has to clean up.
  api_stop
  kafka_pf_stop
  provider_delete "$provider"
  rm -rf "$STATE_DIR"
  say "Gone."
}

