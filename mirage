cmd_counts() {
  require_cluster
  local s t
  s="$(src_count)"; t="$(tgt_count)"
  say "${C_B}Record counts — topic $TOPIC${C_0}"
  printf '  source   %s\n' "${s:-?}"
  printf '  target   %s\n' "${t:-?}"
  local d=$(( ${s:-0} - ${t:-0} ))
  if [ "$d" -eq 0 ]; then
    printf '  deficit  %s0 — in sync%s\n' "$C_GRN" "$C_0"
  elif [ "$d" -lt 0 ]; then
    # Target AHEAD of source = duplicates, now or in the past: a task that keeps
    # failing under autoRestart re-sends what it delivered (lab 18), and a
    # restored offsets topic replays (lab 11). Cumulative, so not proof of "now".
    printf '  deficit  %starget holds %s MORE than source — duplicates were delivered at some point%s\n' "$C_YEL" "$(( -d ))" "$C_0"
  else
    printf '  deficit  %s%s%s\n' "$C_YEL" "$d" "$C_0"
  fi

  # Task state is checked whatever the counts say. One FAILED task freezes only
  # its own partitions; the others carry the load, so totals and deltas read
  # healthy — and autoRestart's re-sends can even put the target ahead.
  local running total tasks_ok=1
  running="$(conn_task_count RUNNING)"; total="$(conn_tasks_total)"
  if [ "${total:-0}" -ge 1 ] && [ "${running:-0}" -lt "${total:-0}" ]; then
    tasks_ok=0
    say "  ${C_RED}only ${running} of ${total} tasks RUNNING${C_0} ${C_DIM}— their partitions are not replicating; start with: mirage status${C_0}"
  fi

  # A cumulative deficit is NOT evidence of a broken pipeline. Any lab that
  # re-seeds the target (7, 12) leaves history behind that will never be
  # re-replicated, because a fresh connector starts at the current offset. That
  # shows up as a large CONSTANT deficit while replication is perfectly healthy.
  # Measure a delta instead — that is what every lab's grader does.
  if { [ "$d" -ne 0 ] || [ "$tasks_ok" -eq 0 ]; } && [ "${1:-}" != "--quick" ]; then
    say ""
    info "Cumulative counts can mislead. Measuring a live delta (produces 300)"
    local delta gaps_b gaps_a stuck
    gaps_b="$(partition_gaps)"
    # batch.size below one record: the sticky partitioner then moves on after
    # every record, so all 12 partitions get some of the 300 and a frozen one
    # cannot hide by receiving none.
    delta="$(replication_delta 300 60 batch.size=1000)"
    # replication_delta returns at 80%, so give healthy partitions time to land
    # the rest before calling a growing gap a stall.
    sleep 10
    gaps_a="$(partition_gaps)"
    stuck="$(gaps_grew "$gaps_b" "$gaps_a")"
    if [ "${delta:-0}" -eq 0 ]; then
      say "  ${C_RED}replication is dead${C_0} — 0 of 300 new records arrived"
      say "  ${C_DIM}Start with: mirage status, then mirage logs${C_0}"
    elif [ -n "$stuck" ]; then
      say "  ${C_RED}partitions falling behind: ${stuck}${C_0} — ${delta} of 300 new records arrived"
      say "  ${C_DIM}The rest of the topic is flowing, so whole-topic numbers look fine."
      say "  A task owns a set of partitions — start with: mirage status${C_0}"
    elif [ "$tasks_ok" -eq 0 ]; then
      say "  ${C_YEL}${delta} of 300 new records arrived, but NOT through every task${C_0}"
      say "  ${C_DIM}A healthy-looking delta here is the other tasks. Not healthy.${C_0}"
    elif [ "${delta:-0}" -ge 240 ]; then
      say "  ${C_GRN}replication is healthy${C_0} — ${delta} of 300 new records arrived"
      if [ "$d" -gt 0 ]; then
        say "  ${C_DIM}Records flow NOW. The ${d}-record deficit is history: after a re-seed"
        say "  (reset --fresh, labs 7/12) that is expected. Without one, those are records"
        say "  the connector SKIPPED — a lost offset position, not a slow pipeline.${C_0}"
      fi
    else
      say "  ${C_YEL}replication is slow${C_0} — only ${delta} of 300 new records arrived"
    fi
  fi
}

# ---- diff: what does the current state look like next to the baseline? ----
# The single most useful on-call reflex is comparing desired state against what
# is actually running. Without this, a lab is a memory game about where faults
# hide; with it, you learn the comparison itself.
cmd_diff() {
  require_cluster
  local tmp cr_file
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/mirage-diff.XXXXXX")" || { err "cannot create temp dir"; exit 1; }
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" EXIT

  hr; say "${C_B}Baseline vs. running state${C_0}"; hr

  # --- KafkaConnector config ---
  say ""
  say "${C_B}KafkaConnector $CONNECTOR${C_0} ${C_DIM}(manifest -> live CR)${C_0}"
  python3 -I - "$LAB_HOME/manifests/connector.yaml" > "$tmp/base.txt" <<'PY' 2>/dev/null
import sys, re
# Minimal reader: the lab manifests are flat spec.config maps, so parse rather
# than require PyYAML, which is not guaranteed to be installed.
txt = open(sys.argv[1]).read()
out = {}
m = re.search(r'^\s*tasksMax:\s*(\S+)', txt, re.M)
if m: out['tasksMax'] = m.group(1).strip('"\'')
cfg = re.search(r'^\s*config:\s*$(.*)', txt, re.M | re.S)
if cfg:
    for line in cfg.group(1).splitlines():
        mm = re.match(r'^\s{4,}([A-Za-z0-9_.\-]+):\s*(.*)$', line)
        if mm:
            out[mm.group(1)] = mm.group(2).strip().strip('"\'')
for k in sorted(out):
    v = out[k]
    # YAML double-quoted scalars escape backslashes, so the manifest holds
    # '\\.' where the live CR holds '\.'. Without unescaping, every regex
    # value reports a phantom difference.
    v = v.replace('\\\\', '\\')
    print(f"{k}={v}")
PY

  kq get kafkaconnector "$CONNECTOR" -o json 2>/dev/null \
    | py_json 'cfg = d.get("spec", {}).get("config", {}) or {}
tm = d.get("spec", {}).get("tasksMax")
if tm is not None: print(f"tasksMax={tm}")
for k in sorted(cfg): print(f"{k}={cfg[k]}")' > "$tmp/live.txt" 2>/dev/null

  if [ ! -s "$tmp/live.txt" ]; then
    warn "  connector $CONNECTOR not found — it may have been deleted or renamed"
    kq get kafkaconnector --no-headers 2>/dev/null | awk '{print "    present: "$1}'
  else
    _print_kv_diff "$tmp/base.txt" "$tmp/live.txt"
  fi

  # --- CR vs what the WORKER is actually running ---
  say ""
  say "${C_B}CR vs worker runtime${C_0} ${C_DIM}(spec.config -> REST /connectors/<n>/config)${C_0}"
  local drift=0 key crv rtv
  # NOTE: tasks.max is deliberately absent. Strimzi owns it via spec.tasksMax
  # and pops it out of spec.config, so "CR unset / runtime 12" is correct here,
  # not drift — reporting it would teach the wrong lesson.
  for key in topics transforms target.cluster.bootstrap.servers \
             source.cluster.bootstrap.servers topics.exclude; do
    crv="$(conn_get ".spec.config.$(printf '%s' "$key" | sed 's/\./\\./g')")"
    rtv="$(runtime_config_value "$key")"
    if [ -n "$crv$rtv" ] && [ "$crv" != "$rtv" ]; then
      printf '  %s~%s %s\n' "$C_YEL" "$C_0" "$key"
      printf '      CR:      %s\n' "${crv:-<unset>}"
      printf '      runtime: %s\n' "${rtv:-<unset>}"
      drift=1
    fi
  done
  if [ "$drift" -eq 0 ]; then
    say "  ${C_GRN}no drift${C_0} — the worker is running what the CR asks for"
  else
    say ""
    say "  ${C_DIM}Drift means the operator could not push config to Connect: usually a"
    say "  rejected config (400) or a blocked rebalance. Fix the worker, not the CR.${C_0}"
  fi

  # --- KafkaConnect worker shape ---
  say ""
  say "${C_B}KafkaConnect $CONNECT${C_0}"
  local want have
  want="$(connect_get '.spec.replicas')"; have="$(ready_connect_pods)"
  printf '  replicas     desired=%s running=%s' "${want:-?}" "${have:-0}"
  [ "${have:-0}" != "${want:-0}" ] && printf '   %s<- mismatch%s' "$C_YEL" "$C_0"
  printf '\n'
  printf '  memory       request=%s limit=%s\n' \
    "$(connect_get '.spec.resources.requests.memory')" \
    "$(connect_get '.spec.resources.limits.memory')"
  printf '  heap         -Xms=%s -Xmx=%s\n' \
    "$(connect_get '.spec.jvmOptions.-Xms')" "$(connect_get '.spec.jvmOptions.-Xmx')"
  # The four identity settings. Renaming any of them points the workers at
  # empty internal topics — no error, no failed status (lab 11).
  local idk bv lv
  for idk in group.id config.storage.topic offset.storage.topic status.storage.topic; do
    bv="$(awk -v k="$idk:" '$1==k {print $2; exit}' "$LAB_HOME/manifests/connect.yaml")"
    lv="$(connect_get ".spec.config.${idk//./\\.}")"
    printf '  %-21s %s' "$idk" "${lv:-<unset>}"
    [ "$lv" != "$bv" ] && printf '   %s<- baseline: %s%s' "$C_YEL" "$bv" "$C_0"
    printf '\n'
  done

  # --- things that only exist when a lab broke something ---
  say ""
  say "${C_B}Anomalies${C_0}"
  local found=0
  local extra
  extra="$(kq get kafkaconnector --no-headers 2>/dev/null | awk -v keep="$CONNECTOR" '$1!=keep {print $1}')"
  if [ -n "$extra" ]; then
    printf '%s\n' "$extra" | while read -r c; do
      printf '  %s+%s unexpected connector: %s\n' "$C_YEL" "$C_0" "$c"
    done
    found=1
  fi
  if kq get resourcequota mirage-quota >/dev/null 2>&1; then
    printf '  %s+%s ResourceQuota present: %s of %s\n' "$C_YEL" "$C_0" \
      "$(kq get resourcequota mirage-quota -o jsonpath='{.status.used.requests\.memory}')" \
      "$(kq get resourcequota mirage-quota -o jsonpath='{.status.hard.requests\.memory}')"
    found=1
  fi
  if kq get kafkanodepool source-pool -o jsonpath='{.spec.template.pod.affinity}' 2>/dev/null | grep -q .; then
    printf '  %s+%s source-pool has a pod affinity rule (broker may be unschedulable)\n' "$C_YEL" "$C_0"
    found=1
  fi
  local junk
  junk="$(list_target_topics 2>/dev/null | grep -cE '\.heartbeats$|^mm2-|\.internal$|\.replica$' || true)"
  if [ "${junk:-0}" -gt 0 ]; then
    printf '  %s+%s %s replication artefact topic(s) on the target\n' "$C_YEL" "$C_0" "$junk"
    found=1
  fi
  local storesets
  storesets="$(list_target_topics 2>/dev/null | grep -cE -- '-connect-configs$' || true)"
  if [ "${storesets:-0}" -gt 1 ]; then
    printf '  %s+%s %s sets of Connect internal topics on the target (one cluster should have one)\n' "$C_YEL" "$C_0" "$storesets"
    found=1
  fi
  [ "$found" -eq 0 ] && say "  ${C_GRN}none${C_0}"

  say ""
  say "${C_DIM}This is the comparison to reach for first in a real incident:"
  say "desired state (CR) vs actual state (runtime), then what is present that"
  say "should not be.${C_0}"
}

# Print a key=value diff between two sorted files, ignoring unchanged keys.
_print_kv_diff() {
  local base="$1" live="$2" any=0
  while IFS= read -r line; do
    local k v bv
    k="${line%%=*}"; v="${line#*=}"
    bv="$(grep -m1 "^${k}=" "$base" 2>/dev/null | sed "s/^${k}=//")"
    if [ -z "$bv" ]; then
      printf '  %s+%s %s = %s %s(added by the fault, or by you)%s\n' "$C_YEL" "$C_0" "$k" "$v" "$C_DIM" "$C_0"
      any=1
    elif [ "$bv" != "$v" ]; then
      printf '  %s~%s %s\n' "$C_YEL" "$C_0" "$k"
      printf '      baseline: %s\n' "$bv"
      printf '      now:      %s\n' "$v"
      any=1
    fi
  done < "$live"
  while IFS= read -r line; do
    local k
    k="${line%%=*}"
    if ! grep -q "^${k}=" "$live" 2>/dev/null; then
      printf '  %s-%s %s %s(removed — baseline had: %s)%s\n' "$C_RED" "$C_0" "$k" "$C_DIM" "${line#*=}" "$C_0"
      any=1
    fi
  done < "$base"
  [ "$any" -eq 0 ] && say "  ${C_GRN}identical to the baseline manifest${C_0}"
}

