case "${1:-help}" in
  setup)    shift; cmd_setup "$@" ;;
  list|ls)  shift; cmd_list "$@" ;;
  start)    shift; cmd_start "$@" ;;
  stop)     shift; cmd_stop "$@" ;;
  hint)     shift; cmd_hint "$@" ;;
  solve)    shift; cmd_solve "$@" ;;
  answer)   shift; cmd_answer "$@" ;;
  status)   shift; cmd_status "$@" ;;
  verify)   shift; cmd_verify "$@" ;;
  next)     shift; cmd_next "$@" ;;
  counts)   shift; cmd_counts "$@" ;;
  diff)     shift; cmd_diff "$@" ;;
  intro)    shift; cmd_intro "$@" ;;
  env)      shift; cmd_env "$@" ;;
  api)      shift; cmd_api "$@" ;;
  kafka)    shift; cmd_kafka "$@" ;;
  kcli)     shift; cmd_kcli "$@" ;;
  why)      shift; cmd_why "$@" ;;
  topics)   shift; cmd_topics "$@" ;;
